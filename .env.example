# SERVER ONLY. Never use a VITE_ prefix for secrets; never paste a key into chat.
GEMINI_API_KEY=
# Confirm this key's project is Free tier with no paid billing in AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
CQA_PROVIDER=gemini
CQA_MODEL=gemini-3.1-flash-lite
CQA_MODE=free
CQA_TIMEOUT_MS=120000
CQA_RETRY_LIMIT=1
# Paste the signed organizer URL here locally, including its original query.
CQA_ORGANIZER_URL=
CQA_DB_PATH=private/cqa.sqlite
PORT=3001
